rules_version = '2';

// =========================================================================
// FIRESTORE SECURITY RULES CHECKLIST & MODEL:
// =========================================================================
// [x] Helper functions:
//     - isSignedIn(): Enforces request.auth != null globally.
//     - isAdmin(): Validates if the authenticated user's role is "admin"
//                  via cross-document lookup to /users/{uid}.
//
// [x] /users/{userId} collection rules:
//     - READ: Any authenticated user can read their own user document.
//             Admin can read any user document.
//     - WRITE (Create, Update, Delete): Restricted exclusively to "admin" role.
//
// [x] /attendance/{attendanceId} collection rules:
//     - CREATE: Requester must be signed in. Admins can specify "admin-manual".
//               Staff can check-in themselves ("fingerprint"/"self-checkin"),
//               but cannot set lastEditedBy, lastEditedAt, or isDeleted=true.
//     - READ: Authenticated users can read their own logs. Admins can read all logs.
//     - UPDATE: Staff can only update 'checkOut' and 'status' on their own logs.
//               Admins have unrestricted update access.
//     - DELETE: Blocked entirely (soft-delete only via updating isDeleted: true).
//
// [x] /auditLogs/{logId} collection rules:
//     - READ: Exclusive to Admins.
//     - CREATE: Exclusive to Admins.
//     - UPDATE/DELETE: Blocked entirely (immutable ledger).
//
// [x] /devices/{deviceId} collection rules:
//     - READ/WRITE: Exclusive to Admins (PWA context).
//
// [x] /biometrics/{userId} collection rules:
//     - READ: Restricted to Admins.
//     - WRITE: Owner or Admin.
// =========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Reusable helper checking if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Reusable helper checking if user is an admin by querying user document
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Rules for users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar'])
      );
    }

    // Rules for attendance collection
    match /attendance/{attendanceId} {
      allow create: if isSignedIn() && (
        (isAdmin() && request.resource.data.markedBy in ["fingerprint", "self-checkin", "admin-manual"]) || (
          request.resource.data.markedByUserId == request.auth.uid &&
          request.resource.data.markedBy in ["fingerprint", "self-checkin"] &&
          !(request.resource.data.keys().hasAny(['lastEditedBy', 'lastEditedAt'])) &&
          (!request.resource.data.keys().hasAll(['isDeleted']) || request.resource.data.isDeleted == false)
        )
      );
      allow read: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkOut', 'status'])
        ) || (
          resource.data.markedByUserId == request.auth.uid &&
          request.time < resource.data.createdAt + duration.value(10, 'm') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkIn', 'status', 'selfEdited', 'selfEditedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    // Rules for auditLogs collection
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.action in ['create', 'self-edit'] &&
        request.resource.data.performedBy == request.auth.uid
      );
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Rules for devices collection
    match /devices/{deviceId} {
      allow read, write: if isAdmin();
    }

    // Rules for sensitive biometrics collection (templates and IDs)
    match /biometrics/{userId} {
      allow read: if isAdmin();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Rules for public usernameIndex mapping lookup
    match /usernameIndex/{username} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
