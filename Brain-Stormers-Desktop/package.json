{
  "name": "brain-stormers-desktop",
  "version": "1.0.1",
  "description": "Desktop wrapper for Brain Stormers Attendance PWA using Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron main.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build": "electron-builder"
  },
  "keywords": [
    "electron",
    "attendance",
    "desktop"
  ],
  "author": "Brain Stormers",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.2.1",
    "firebase-admin": "^12.1.0",
    "koffi": "^2.9.1"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.brainstormers.desktop",
    "productName": "Brain Stormers Attendance",
    "publish": {
      "provider": "github",
      "owner": "BrainStormersAcc",
      "repo": "Brain-Stormers-Attendance",
      "private": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**",
      "index.html",
      "error.html",
      "settings.html",
      "src/**",
      "../dist/**"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
